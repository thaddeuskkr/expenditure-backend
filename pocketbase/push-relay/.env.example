APNS_TEAM_ID=YOUR_APPLE_TEAM_ID
APNS_KEY_ID=YOUR_PRODUCTION_KEY_ID
APNS_TOPIC=dev.tkkr.Expenditure

# Existing files on the Docker host, readable by RELAY_UID:RELAY_GID.
APNS_KEY_FILE=/opt/expenditure/secrets/production-apns.p8
RELAY_SECRET_FILE=/opt/expenditure/secrets/relay-secret

RELAY_UID=1000
RELAY_GID=1000
RELAY_PORT=8091
PUSH_RELAY_NETWORK=expenditure-push
